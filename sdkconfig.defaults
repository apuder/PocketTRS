# PocketTRS: ESP32-WROVER (4MB flash, PSRAM). Settings that differ from the
# ESP-IDF defaults, on top of FabGL's (components/FabGL/idf/sdkconfig.fabgl,
# see CMakeLists.txt). `idf.py build` generates sdkconfig from these.

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# libsmb2, mongoose and TRS-IO do not build warning-free with GCC 15
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y
# IDF 6 defaults to picolibc; TRS-IO has only been run on newlib
CONFIG_LIBC_NEWLIB=y

# PSRAM: Z80 memory and Grafyx live in .ext_ram.bss
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Internal memory is what VGA, Wi-Fi and the Bluetooth controller need and
# what there is the least of. Task stacks have to be internal as well: on
# ESP32 revisions before v3 a task that ends up in ROM code (Wi-Fi,
# Bluetooth) cannot have its stack in PSRAM. So: allocations of more than 4K
# go to PSRAM, as do mDNS, the NVS cache and TLS, and Wi-Fi gets by with
# fewer buffers.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6

# IRAM: with FabGL, Wi-Fi and Bluetooth it is full. The PSRAM workaround for
# ESP32 revisions before v3 puts a copy of the C library there; only what an
# interrupt handler may call while the flash cache is off (memcpy, strlen,
# setjmp, ...) has to stay.
# CONFIG_SPIRAM_CACHE_LIBMATH_IN_IRAM is not set
# CONFIG_SPIRAM_CACHE_LIBNUMPARSER_IN_IRAM is not set
# CONFIG_SPIRAM_CACHE_LIBIO_IN_IRAM is not set
# CONFIG_SPIRAM_CACHE_LIBTIME_IN_IRAM is not set
# CONFIG_SPIRAM_CACHE_LIBCHAR_IN_IRAM is not set
# CONFIG_SPIRAM_CACHE_LIBRAND_IN_IRAM is not set
# CONFIG_SPIRAM_CACHE_LIBENV_IN_IRAM is not set
# CONFIG_SPIRAM_CACHE_LIBFILE_IN_IRAM is not set
# CONFIG_SPIRAM_CACHE_LIBMISC_IN_IRAM is not set

# The main task starts Wi-Fi, mounts the SD card and then runs the Z80 and
# the configuration menu. Measured: it uses 2.3K of its stack, the event
# task 1.3K.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6000
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# The Z80 runs in the main task on CPU 0 and never yields
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0 is not set
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
# CONFIG_ESP_INT_WDT_CHECK_CPU1 is not set

CONFIG_LWIP_LOCAL_HOSTNAME="PocketTRS"
# Ask for the time as soon as Wi-Fi is up
# CONFIG_LWIP_SNTP_STARTUP_DELAY is not set
CONFIG_LWIP_MAX_SOCKETS=16
